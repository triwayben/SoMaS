{
  "name": "somas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SoMaS — a Sonos-style web controller for Music Assistant",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:lan": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "preview:lan": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "lan": "npm run build && npm run preview:lan"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.2",
    "vite": "6.0.7"
  }
}
